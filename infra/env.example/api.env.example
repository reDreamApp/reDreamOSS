# Database — self-hosted Supabase's Postgres (one Postgres, ADR 0001).
# `supabase-db` is the Postgres service inside the supabase network. Replace
# <password> with the actual postgres password from your Supabase .env.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@supabase-db:5432/postgres

# Supabase
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification. ISS must equal API_EXTERNAL_URL in /srv/supabase/.env
# character for character (GoTrue uses it as the token issuer), e.g.
# https://supabase.redream.example.com/auth/v1. JWKS is served by GoTrue
# inside the Supabase network.
SUPABASE_JWT_ISS=
SUPABASE_JWKS_URL=http://auth:9999/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ALGORITHMS=ES256

# Reports + moderation — email + HMAC-signed links (ADR 0006, no Telegram)
REPORT_RETENTION_DAYS=180
REPORT_CONTEXT_BEFORE=2
REPORT_CONTEXT_AFTER=2
REPORT_RATE_LIMIT_COUNT=5
REPORT_RATE_LIMIT_WINDOW_MINUTES=10
REPORT_INTERNAL_ACTION_KEY=
REPORT_ACTION_BASE_URL=https://redream.example.com/internal
REPORT_NOTIFICATION_EMAIL=
REPORT_NOTIFICATION_EMAIL_FROM=
REPORT_NOTIFICATION_HMAC_SECRET=

# AI service
AI_SERVICE_URL=http://ai:8080
AI_REQUEST_TIMEOUT=30

# Langfuse's own database: the same server as above, the `langfuse` database
# and role from langfuse.env. The backend only uses it to delete a user's
# traces on a GDPR purge (Langfuse v2 has no API for that).
LANGFUSE_DATABASE_URL=postgresql+asyncpg://langfuse:<password>@supabase-db:5432/langfuse

ENVIRONMENT=production
LOG_LEVEL=INFO

# Public storage host used for refreshed short-lived audio links.
SUPABASE_PUBLIC_URL=https://supabase.YOUR_DOMAIN
REHEARSAL_URL_TTL_SECONDS=300
