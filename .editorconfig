root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,md}]
indent_size = 4

[*.{yml,yaml,json,toml,dart,sh,Dockerfile,Caddyfile}]
indent_size = 2

[Makefile]
indent_style = tab

# caddy fmt indents with tabs.
[Caddyfile]
indent_style = tab
