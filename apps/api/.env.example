# Database — async driver only (asyncpg in prod, aiosqlite in tests).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISS=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ALGORITHMS=ES256

# Reports + moderation (ADR 0006 — email + HMAC links, no Telegram)
REPORT_CONTEXT_BEFORE=2
REPORT_CONTEXT_AFTER=2
REPORT_RATE_LIMIT_COUNT=5
REPORT_RATE_LIMIT_WINDOW_MINUTES=10
REPORT_ACTION_BASE_URL=http://localhost:8001/internal
REPORT_NOTIFICATION_EMAIL=
REPORT_NOTIFICATION_EMAIL_FROM=
REPORT_NOTIFICATION_HMAC_SECRET=

# SMTP (used by services/email_notification when REPORT_NOTIFICATION_EMAIL is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Token budget (ADR 0008)
DAILY_LLM_TOKEN_BUDGET=100000
# All users together per day; chat, transcription and new TTS share this cap.
DAILY_LLM_TOKEN_BUDGET_TOTAL=500000
# Price-weighted TTS units per character: $16/M chars / roughly $2/M chat tokens.
TTS_BUDGET_TOKENS_PER_CHARACTER=8

# Art. 9 consent-text version. Bump ONLY on material consent-copy changes
# (new processor / new purpose) — a bump forces every user to re-consent.
CONSENT_VERSION=2026-10-07

# AI service
AI_SERVICE_URL=http://localhost:8080
AI_REQUEST_TIMEOUT=90
# DEV-ONLY: skip the crisis pre-classifier (ADR 0005). NEVER false in
# production — see the re-enable gate in docs/ROADMAP.md.
SAFETY_CLASSIFIER_ENABLED=true

# Langfuse's own database (ADR 0007), e.g.
# postgresql+asyncpg://langfuse:<password>@localhost:5432/langfuse
# Only the GDPR purge uses it, to delete a user's traces. Empty = skip.
LANGFUSE_DATABASE_URL=

LOG_LEVEL=INFO

SUPABASE_PUBLIC_URL=
REHEARSAL_URL_TTL_SECONDS=300
