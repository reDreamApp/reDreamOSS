# Database — async driver only (asyncpg in prod, aiosqlite in tests).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISS=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ALGORITHMS=ES256

# Art. 9 consent-text version. Bump ONLY on material consent-copy changes
# (new processor / new purpose) — a bump forces every user to re-consent.
CONSENT_VERSION=2026-10-07

# AI service
AI_SERVICE_URL=http://localhost:8080
AI_REQUEST_TIMEOUT=90
# DEV-ONLY: skip the crisis pre-classifier (ADR 0005). NEVER false in
# production — see the re-enable gate in docs/ROADMAP.md.
SAFETY_CLASSIFIER_ENABLED=true

LOG_LEVEL=INFO

SUPABASE_PUBLIC_URL=
REHEARSAL_URL_TTL_SECONDS=300
