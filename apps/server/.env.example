# Database — async driver only (asyncpg in prod, aiosqlite in tests).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISS=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ALGORITHMS=ES256

# Supabase Storage — rehearsal audio upload target
SUPABASE_STORAGE_BUCKET=rehearsal-audio
# Public Supabase host for the signed audio URLs (needed when SUPABASE_URL is internal)
SUPABASE_PUBLIC_URL=
# Lifetime of the signed audio URL stored on the dream (default 5 minutes)
REHEARSAL_URL_TTL_SECONDS=300

# Art. 9 consent-text version. Bump ONLY on material consent-copy changes
# (new processor / new purpose) — a bump forces every user to re-consent.
CONSENT_VERSION=2026-10-07

# Chat LLM — any OpenAI-compatible chat-completions endpoint, one provider for
# every text role. Real values live only in the gitignored .env (NEVER commit
# them). Without the first four, chat turns and the crisis check fail.
LLM_BASE_URL=
# Servers without auth (Ollama, vLLM without --api-key) still need a
# non-empty value, e.g. LLM_API_KEY=none
LLM_API_KEY=
# Replies, nightmare summary, summary extraction
LLM_MODEL=
# Routing, rewrite-safety segmenter + classifier, small checks
LLM_SMALL_MODEL=
# Crisis check (ADR 0005); empty = LLM_SMALL_MODEL
LLM_SAFETY_MODEL=
LLM_TIMEOUT_SECONDS=60
# The crisis check blocks the chat turn, so it gets less
LLM_SAFETY_TIMEOUT_SECONDS=20
# Ask for JSON output (response_format json_object); false for endpoints that
# reject it — the answers are then parsed out of prose or code fences
LLM_JSON_MODE=true
#
# Mistral La Plateforme:
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-2512
# LLM_SMALL_MODEL=mistral-small-2603
# LLM_SAFETY_MODEL=ministral-8b-2512
#
# Scaleway Generative APIs (a key restricted to a project other than the
# organization's default one needs https://api.scaleway.ai/<project_id>/v1):
# LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_MODEL=mistral-medium-3.5-128b
# LLM_SMALL_MODEL=mistral-small-3.2-24b-instruct-2506

# Rewrite-safety critic in the rewriting stage. false runs chat without it
# (a warning is logged at startup).
SAFETY_CRITIC_ENABLED=true

# Speech (STT/TTS) still uses these provider keys; S09 replaces them.
MISTRAL_API_KEY=
SCALEWAY_API_KEY=
# Only when the Scaleway key is restricted to a project that is not the
# organization's default one (empty = default project).
SCALEWAY_PROJECT_ID=

# Speech models — pinned per ADR 0010 (do not use floating aliases).
VOXTRAL_TTS_MODEL=voxtral-mini-tts-3-0
# STT (ADR 0010, 2026-07-09 amendment): Whisper on Scaleway primary (raw voice
# audio stays in the zero-retention chain), Voxtral Transcribe V2 fallback.
WHISPER_STT_MODEL=openai/whisper-large-v3:fp16
VOXTRAL_STT_MODEL=voxtral-mini-2602

# Voxtral TTS voice per language: a preset slug (GET /v1/audio/voices) or a
# saved voice id. TTS rejects requests without one. German: preset "Heidi"
# (needs the speech v3 model above).
VOXTRAL_VOICE_ID_EN=gb_jane_neutral
VOXTRAL_VOICE_ID_DE=voice_481

# Crisis pre-classifier
# DEV-ONLY: skip the crisis pre-classifier (ADR 0005). NEVER false in
# production — see the re-enable gate in docs/ROADMAP.md.
SAFETY_CLASSIFIER_ENABLED=true

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
